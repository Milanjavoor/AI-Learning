from dotenv import load_dotenv
from langchain_google_genai import ChatGoogleGenerativeAI
load_dotenv()

llm=ChatGoogleGenerativeAI(model="gemma-4-31b-it")
question=input("enter question")
response=llm.invoke(question)
print(response.text)

new=llm.invoke([["system","You are a helpful ai agent who answer in just three lines"],
            ["human",question]])
print(new.text)

llm=ChatGoogleGenerativeAI(model="gemma-4-31b-it",temperature=0.8)
new_ques=input("Enter creative question")
creative=llm.invoke(new_ques)
print(creative.text)

from langchain_groq import ChatGroq
llm2=ChatGroq(model="qwen/qwen3-3b",reasoning_format="parsed")
message1=input("enter you query")
messages=[ ("system","you are a helpful ai assisstent to give short answers too queries"), ("human",message1)] 
response=llm2.invoke(messages)
print(response.content)
