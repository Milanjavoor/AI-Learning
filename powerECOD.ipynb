import pandas as pd
import numpy as np
import json
import warnings
from pathlib import Path
!pip install pyod
from pyod.models.ecod import ECOD
from sklearn.preprocessing import RobustScaler


#============================================ Configurations==========================================

output_dir=Path("energy_results")
output_dir.mkdir(exist_ok=True)
train_ratio=0.70
validation_ratio=0.15
test_ratio=0.15

Threshold_percentile=99.0

correlation_threshold=0.95
assert abs(train_ratio+test_ratio+validation_ratio-1)< 1e-9



#========================================= Load and audit data ==============================================

df=pd.read_csv(r"/content/final_dataset1.csv")

required_columns={ "timestamp", "building_id", "site_id", "load", "sqm",
    "airTemperature", "dewTemperature", "windSpeed",
    "precipDepth1HR", "cooling", "heating",
    "lag_24", "lag_168", "avg_last_24h", "avg_last_week",
    "Global_reactive_power", "Voltage"}

missing_columns=required_columns-set(df.columns)

if missing_columns:
  raise ValueError("Some columns are missing in required columns")
print("Original shape:", df.shape)
print("Missing cells:", int(df.isna().sum().sum()))
print("Exact duplicate rows:", int(df.duplicated().sum()))
print("Unique buildings:", df["building_id"].nunique())
print("Unique sites:", df["site_id"].nunique())

df["timestamp"] = pd.to_datetime(
    df["timestamp"],
    format="%d-%m-%Y %H:%M",
    errors="coerce"
)

df=df.dropna(subset=["timestamp","building_id"]).copy()

numeric_columns=[c for c in df.columns
                 if c not in ["timestamp", "building_id", "site_id"]]
for col in numeric_columns:
  df[col]=pd.to_numeric(df[col],errors="coerce")

df.loc[df["precipDepth1HR"]==-1,"precipDepth1HR"]=np.nan

df = df.replace([np.inf, -np.inf], np.nan)

df = df.drop_duplicates().copy()

duplicate_keys = df.duplicated(
    subset=["building_id", "timestamp"],
    keep=False
)

print("Repeated building-time rows:", int(duplicate_keys.sum()))
print("Rows after basic cleaning:", len(df))

df = df.sort_values(
    ["timestamp", "building_id"]
).reset_index(drop=True)

df["row_id"]=np.arange(len(df))
audit = pd.DataFrame({
    "dtype": df.dtypes.astype(str),
    "missing_count": df.isna().sum(),
    "unique_values": df.nunique(dropna=True)
})
audit.to_csv(output_dir / "data_audit.csv")



#============================================================== Chronological train/validation/test splitting ========================================================================


unique_times = np.sort(df["timestamp"].unique())

if len(unique_times) < 10:
    raise ValueError("Insufficient distinct timestamps for splitting.")

train_cut = int(len(unique_times) * train_ratio)
validation_cut = int(
    len(unique_times) * (train_ratio + validation_ratio)
)

train_end=pd.Timestamp(unique_times[train_cut])
validation_end = pd.Timestamp(unique_times[validation_cut])

train_mask = df["timestamp"] < train_end

validation_mask = (
    (df["timestamp"] >= train_end)
    & (df["timestamp"] < validation_end)
)
test_mask = df["timestamp"] >= validation_end

print("\n========== TEMPORAL SPLIT ==========")

for name, mask in [
    ("Train", train_mask),
    ("Validation", validation_mask),
    ("Test", test_mask)
]:
    print(
        f"{name}: {mask.sum():,} rows "
        f"({mask.mean() * 100:.2f}%)"
    )

print("Train end boundary:", train_end)
print("Validation end boundary:", validation_end)

if not train_mask.any() or not validation_mask.any() or not test_mask.any():
    raise ValueError("One of the chronological splits is empty.")

#========================================= Feature  Enginnering ==================================================================================================================
df["hour_feature"]=df["timestamp"].dt.hour
df["weekday_feature"] = df["timestamp"].dt.dayofweek
df["month_feature"] = df["timestamp"].dt.month
df["is_weekend_feature"] = (
    df["weekday_feature"] >= 5
).astype(int)
df["hour_sin"] = np.sin(
    2 * np.pi * df["hour_feature"] / 24
)
df["hour_cos"] = np.cos(
    2 * np.pi * df["hour_feature"] / 24
)

df["weekday_sin"] = np.sin(
    2 * np.pi * df["weekday_feature"] / 7
)
df["weekday_cos"] = np.cos(
    2 * np.pi * df["weekday_feature"] / 7
)

df["month_sin"] = np.sin(
    2 * np.pi * (df["month_feature"] - 1) / 12
)
df["month_cos"] = np.cos(
    2 * np.pi * (df["month_feature"] - 1) / 12
)


df["log_load"] = np.log1p(
    df["load"].clip(lower=0)
)

valid_area = df["sqm"].where(df["sqm"] > 0)

df["load_per_sqm"] = (
    df["load"] / valid_area
)

df["log_load_per_sqm"] = np.log1p(
    df["load_per_sqm"].clip(lower=0)
)
df["deviation_lag24"] = df["load"] - df["lag_24"]
df["deviation_lag168"] = df["load"] - df["lag_168"]

df["deviation_avg24"] = (
    df["load"] - df["avg_last_24h"]
)
df["deviation_avgweek"] = (
    df["load"] - df["avg_last_week"]
)


df["relative_deviation_24h"] = (
    df["deviation_avg24"]
    / (df["avg_last_24h"].abs() + 1e-6)
)

df["relative_deviation_week"] = (
    df["deviation_avgweek"]
    / (df["avg_last_week"].abs() + 1e-6)
)

df["log_reactive_power"] = np.log1p(
    df["Global_reactive_power"].clip(lower=0)
)
training_rows = df.loc[train_mask]

global_median = training_rows["load"].median()

global_mad = np.median(
    np.abs(training_rows["load"] - global_median)
)

global_scale = max(1.4826 * global_mad, 1e-6)

building_medians = training_rows.groupby(
    "building_id"
)["load"].median()

building_mads = training_rows.groupby(
    "building_id"
)["load"].apply(
    lambda s: np.median(np.abs(s - np.median(s)))
)

building_scales = (
    1.4826 * building_mads
).where(lambda s: s > 1e-6, global_scale)

df["baseline_median"] = (
    df["building_id"].map(building_medians)
    .fillna(global_median)
)

df["baseline_scale"] = (
    df["building_id"].map(building_scales)
    .fillna(global_scale)
)

df["building_robust_z"] = (
    df["load"] - df["baseline_median"]
) / df["baseline_scale"]



candidate_features = [
    "log_load",
    "log_load_per_sqm",
    "building_robust_z",
    "relative_deviation_24h",
    "relative_deviation_week",
    "log_reactive_power",
    "Voltage",
    "airTemperature",
    "dewTemperature",
    "windSpeed",
    "precipDepth1HR",
    "cooling",
    "heating",
    "hour_sin",
    "hour_cos",
    "weekday_sin",
    "weekday_cos",
    "month_sin",
    "month_cos",
    "is_weekend_feature"
]

X_raw = df[candidate_features].copy()

X_raw = X_raw.replace(
    [np.inf, -np.inf], np.nan
)

train_raw = X_raw.loc[train_mask]

imputation_values = train_raw.median().fillna(0)

X_imputed = X_raw.fillna(imputation_values).fillna(0)
nonconstant_features = [
    col for col in X_imputed.columns
    if X_imputed.loc[train_mask, col].nunique() > 1
]

X_imputed = X_imputed[nonconstant_features]

train_corr = X_imputed.loc[train_mask].corr(
    method="spearman"
)

kept_features = []
dropped_features = []

for feature in X_imputed.columns:
    redundant_with = None

    for kept in kept_features:
        corr_value = train_corr.loc[feature, kept]

        if (
            pd.notna(corr_value)
            and abs(corr_value) >= correlation_threshold
        ):
            redundant_with = kept
            break

    if redundant_with is None:
        kept_features.append(feature)
    else:
        dropped_features.append({
            "dropped_feature": feature,
            "retained_feature": redundant_with,
            "spearman_correlation": train_corr.loc[
                feature, redundant_with
            ]
        })

X = X_imputed[kept_features].copy()

pd.DataFrame(
    dropped_features,
    columns=[
        "dropped_feature",
        "retained_feature",
        "spearman_correlation"
    ]
).to_csv(
    output_dir / "correlation_pruning_report.csv",
    index=False
)

train_corr.loc[kept_features, kept_features].to_csv(
    output_dir / "selected_feature_correlations.csv"
)

print("\nSelected features:", kept_features)
print("Number of selected features:", len(kept_features))
print("Pruned features:", len(dropped_features))

scaler = RobustScaler()

X_train = scaler.fit_transform(
    X.loc[train_mask]
)

X_validation = scaler.transform(
    X.loc[validation_mask]
)

X_test = scaler.transform(
    X.loc[test_mask]
)


pd.DataFrame({
    "feature": kept_features,
    "training_median": scaler.center_,
    "training_scale": scaler.scale_
}).to_csv(
    output_dir / "scaler_statistics.csv",
    index=False
)
model = ECOD(contamination=0.01)

model.fit(X_train)

# Score all partitions with the same frozen model.
train_scores = model.decision_function(X_train)
validation_scores = model.decision_function(X_validation)
test_scores = model.decision_function(X_test)

# Explicit threshold based on training-score distribution.
# This avoids using test labels or test outcomes for tuning.
threshold = float(
    np.percentile(
        train_scores,
        Threshold_percentile
    )
)

print("\n========== MODEL ==========")
print("Algorithm: ECOD")
print("Training-score threshold:", threshold)
print("Threshold percentile:", Threshold_percentile)
sensitivity_rows = []

for percentile in [99.0, 99.5, 99.75]:
    candidate_threshold = float(
        np.percentile(train_scores, percentile)
    )

    for split_name, scores in [
        ("Train", train_scores),
        ("Validation", validation_scores),
        ("Test", test_scores)
    ]:
        flags = scores > candidate_threshold

        sensitivity_rows.append({
            "threshold_percentile": percentile,
            "threshold_value": candidate_threshold,
            "split": split_name,
            "observations": len(scores),
            "anomaly_candidates": int(flags.sum()),
            "alert_rate_percent": float(flags.mean() * 100),
            "score_median": float(np.median(scores)),
            "score_p95": float(np.percentile(scores, 95)),
            "score_p99": float(np.percentile(scores, 99))
        })

sensitivity = pd.DataFrame(sensitivity_rows)

sensitivity.to_csv(
    output_dir / "threshold_sensitivity.csv",
    index=False
)

print("\n========== THRESHOLD SENSITIVITY ==========")
print(sensitivity.to_string(index=False))


def evaluate_split(name, scores, mask):
    flags = scores > threshold

    return {
        "split": name,
        "observations": len(scores),
        "threshold": threshold,
        "anomaly_candidates": int(flags.sum()),
        "alert_rate_percent": float(flags.mean() * 100),
        "score_mean": float(np.mean(scores)),
        "score_median": float(np.median(scores)),
        "score_p95": float(np.percentile(scores, 95)),
        "score_p99": float(np.percentile(scores, 99))
    }


evaluation = pd.DataFrame([
    evaluate_split("Train", train_scores, train_mask),
    evaluate_split(
        "Validation", validation_scores, validation_mask
    ),
    evaluate_split("Test", test_scores, test_mask)
])

evaluation.to_csv(
    output_dir / "evaluation_summary.csv",
    index=False
)

print("\n========== EVALUATION SUMMARY ==========")
print(evaluation.to_string(index=False))
